# ------------------------------------------------------------------------------
# TRAVEL DIARY — ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# App Environment
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# Database (PostgreSQL)
POSTGRES_DB=travel_diary
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_password_change_me
DATABASE_URL=postgresql://travel_user:travel_password_change_me@localhost:5432/travel_diary

# Object Storage (MinIO / S3)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=travel-diary-media
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password_change_me
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_random_32_bytes_hex_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_random_32_bytes_hex_for_refresh_tokens
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Redis (Optional — leave empty if not running with-redis profile)
REDIS_URL=redis://localhost:6379
